{
  "name": "dsh-code-workspace",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: VS Code-compatible multi-root workspaces. A .code-workspace file is the single source of truth — its `folders` become writable roots of the session, exactly as in VS Code / Trae / Cursor.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "code-workspace",
    "multi-root",
    "workspace",
    "vscode"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchiddream/dsh-code-workspace.git"
  },
  "homepage": "https://github.com/orchiddream/dsh-code-workspace#readme",
  "bugs": {
    "url": "https://github.com/orchiddream/dsh-code-workspace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
